<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1E3A8A"
        app:title="Checkout"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/arrow_back" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Saved Addresses Section -->
            <TextView
                android:id="@+id/savedAddressesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved Addresses"
                android:textStyle="bold"
                android:textColor="#1E3A8A"
                android:textSize="17sp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/savedAddressesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/noSavedAddressesTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No saved addresses yet"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/addNewAddressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Address"
                android:textStyle="bold"
                android:textColor="#1E3A8A"
                android:textSize="17sp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Full Name -->
            <EditText
                android:id="@+id/fullName"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Full Name"
                android:textSize="16sp"
                android:padding="14dp"
                android:background="@drawable/edittext_bg" />

            <!-- Mobile Number -->
            <EditText
                android:id="@+id/mobileNumber"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:hint="Mobile Number"
                android:textSize="16sp"
                android:inputType="phone"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="@drawable/edittext_bg" />

            <!-- Delivery Address -->
            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Delivery Address"
                android:textSize="16sp"
                android:gravity="top|start"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:background="@drawable/edittext_bg" />

            <!-- Save Address Checkbox -->
            <CheckBox
                android:id="@+id/saveAddressCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save this address for future orders"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:checked="true" />

            <!-- Payment Options Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Options"
                android:textStyle="bold"
                android:textColor="#1E3A8A"
                android:textSize="17sp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <!-- Payment Options -->
            <RadioGroup
                android:id="@+id/paymentOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/codOption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cash on Delivery"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <RadioButton
                    android:id="@+id/onlineOption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online Payment"
                    android:textSize="16sp" />
            </RadioGroup>

            <!-- Confirm Order Button -->
            <Button
                android:id="@+id/confirmOrderBtn"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="28dp"
                android:text="Confirm Order"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textColor="@android:color/white"
                android:backgroundTint="#1E40AF"
                android:layout_marginBottom="40dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
