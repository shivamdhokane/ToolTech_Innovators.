<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/addressNameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="John Doe"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#1E3A8A" />

            <TextView
                android:id="@+id/defaultLabelTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEFAULT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#16A34A"
                android:background="#D1FAE5"
                android:padding="4dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/addressMobileTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+91 9876543210"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/addressTextTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="123, Main Street, City, State - 123456"
            android:textSize="14sp"
            android:textColor="#374151"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/selectAddressBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Use This Address"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:backgroundTint="#1E40AF"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

